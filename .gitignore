# --- credentials that must never be committed ---
# Service-account / Admin SDK keys bypass every Firestore security rule.
# (fitness/firebase-config.js is NOT secret and IS committed — see the note in it.)
service-account.json
*service-account*.json
*-adminsdk-*.json
.env
.env.*

# This repo is public. Never let progress photos or body metrics in here.
Photos/
photos/
*.jpeg
*.jpg
*.png
metrics.json
measurements.*

# App icons are the one intended exception — generated by tools/make-icons.mjs,
# no photographic content. Listed explicitly so the blanket *.png rule above
# keeps protecting everything else. Two sets: the root "Second Brain" app and
# dailyplan/, which installs separately.
!icon-180.png
!icon-192.png
!icon-512.png
!dailyplan/icon-180.png
!dailyplan/icon-192.png
!dailyplan/icon-512.png

node_modules/
.DS_Store
Thumbs.db

# .claude/ is local tool config by default, except the project subagents,
# custom commands, and settings.json, which are meant to be part of the repo
# — see .claude/agents/*.md, .claude/commands/*.md, .claude/settings.json.
# settings.local.json stays ignored: that's per-user/per-machine, unlike
# settings.json which holds no secrets, just shared plugin config.
.claude/*
!.claude/agents/
!.claude/agents/*.md
!.claude/commands/
!.claude/commands/*.md
!.claude/settings.json
