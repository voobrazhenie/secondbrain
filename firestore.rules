rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // An admin is a document, not a claim on the token, so it can be granted
    // without reissuing anybody's sign-in.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validSets(sets) {
      return sets is list
        && sets.size() == 3
        && sets[0] is int && sets[0] > 0 && sets[0] <= 999
        && sets[1] is int && sets[1] > 0 && sets[1] <= 999
        && sets[2] is int && sets[2] > 0 && sets[2] <= 999;
    }

    // Which of the three sets have actually been ticked off. Optional: days
    // recorded before per-set tracking existed carry `sets` and `completed`
    // and no `done`, and they still have to validate. A missing list reads as
    // "all three, if the exercise is complete" on the page, never as zero.
    function validDone(done) {
      return done is list
        && done.size() == 3
        && done[0] is bool && done[1] is bool && done[2] is bool;
    }

    // Only entries this write actually touched are checked. Validating all ten
    // on every write is what broke the page: the cost grows with the size of
    // the stored map, and at six exercises a single tapped set blew past
    // Firestore's cap of 1000 evaluated expressions per request, so every write
    // after the fifth exercise was rejected. `changed` keeps the work
    // proportional to the tap, not to the day's history.
    function validExercise(exercises, changed, id) {
      return !changed.hasAny([id]) || !(id in exercises) || (
        exercises[id] is map
        && exercises[id].keys().hasAll(['sets', 'completed'])
        && exercises[id].keys().hasOnly(['sets', 'completed', 'done'])
        && validSets(exercises[id].sets)
        && exercises[id].completed is bool
        && (!('done' in exercises[id]) || validDone(exercises[id].done))
      );
    }

    function validExerciseDay(date) {
      let data = request.resource.data;
      // On a create there is no prior document. Testing `request.method` rather
      // than `resource == null` on purpose: the null check still dereferences
      // `resource.data` in the other branch and fails the write.
      let before = request.method == 'create' ? {} : resource.data.get('exercises', {});
      let changed = data.exercises.diff(before).affectedKeys();
      return data.keys().hasAll(['date', 'planVersion', 'exercises', 'workoutCompleted', 'updatedAt'])
        && data.keys().hasOnly(['date', 'planVersion', 'exercises', 'workoutCompleted', 'updatedAt'])
        && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.date == date
        && data.planVersion == 2
        && data.exercises is map
        // Retired movements stay on this list on purpose. Signing off a
        // workout merges into the existing document, so rules see the whole
        // merged result — a day recorded under the old routine has to stay
        // valid, and a browser tab still holding the old plan has to keep
        // saving. Nothing is removed here when the routine changes; ids are
        // only ever added.
        && data.exercises.keys().hasOnly([
          'push-ups',
          'pike-push-ups',
          'chair-dips',
          'diamond-push-ups',
          'prone-rows',
          'glute-bridges',
          'single-leg-romanian-deadlifts',
          'decline-push-ups',
          'single-leg-glute-bridges',
          'leg-raises'
        ])
        && changed.hasOnly([
          'push-ups',
          'pike-push-ups',
          'chair-dips',
          'diamond-push-ups',
          'prone-rows',
          'glute-bridges',
          'single-leg-romanian-deadlifts',
          'decline-push-ups',
          'single-leg-glute-bridges',
          'leg-raises'
        ])
        && validExercise(data.exercises, changed, 'push-ups')
        && validExercise(data.exercises, changed, 'pike-push-ups')
        && validExercise(data.exercises, changed, 'chair-dips')
        && validExercise(data.exercises, changed, 'diamond-push-ups')
        && validExercise(data.exercises, changed, 'prone-rows')
        && validExercise(data.exercises, changed, 'glute-bridges')
        && validExercise(data.exercises, changed, 'single-leg-romanian-deadlifts')
        && validExercise(data.exercises, changed, 'decline-push-ups')
        && validExercise(data.exercises, changed, 'single-leg-glute-bridges')
        && validExercise(data.exercises, changed, 'leg-raises')
        && data.workoutCompleted is bool
        && data.updatedAt == request.time;
    }

    // Who may use the admin pages. Written by hand — the Firebase console or
    // the Admin SDK — and never by the app: an account that could add itself
    // here could then grant itself everything below.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // One card per person, so the admin pages can list who exists at all.
    // Written by that person's own page when they sign in, from what Google
    // already returned — signing in asks for nothing extra. The email has to be
    // the one they actually signed in with, so a card cannot be filed under
    // somebody else's address.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'lastSeen'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // Which sections a person sees. Theirs to read, an admin's to set. It sits
    // here rather than under users/{uid}/config/ on purpose: the catch-all
    // below lets a person write anything of their own, which would include
    // switching their own sections back on.
    match /features/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid}/exerciseDays/{date} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validExerciseDay(date);
      allow delete: if isOwner(uid);
    }

    // Preserve the existing owner-only policy for all unrelated user data while
    // keeping exerciseDays on the stricter schema above.
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if collection != 'exerciseDays' && isOwner(uid);
    }
  }
}
